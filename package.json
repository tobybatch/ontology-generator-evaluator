{
  "name": "ontology-genrator-evaluator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf static/govuk",
    "copy:assets": "copyfiles -u 5 \"node_modules/govuk-frontend/dist/govuk/assets/**/*\" static/govuk/assets",
    "copy:js": "copyfiles -f node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js static/govuk/javascripts",
    "copy": "run-p copy:assets copy:js",
    "build:sass": "sass src/scss/application.scss static/govuk/stylesheets/application.min.css --style=compressed --load-path=node_modules",
    "build": "run-s clean copy build:sass",
    "watch:sass": "sass --watch src/scss/application.scss static/govuk/stylesheets/application.min.css --load-path=node_modules",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "govuk-frontend": "^6.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "copyfiles": "^2.4.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.4",
    "sass": "^1.108.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
